# Database (Docker Compose default)
DATABASE_URL=postgres://radar:radar@postgres:5432/diy_buy_radar
# Local without Docker: set USE_PGLITE=1 (ignores DATABASE_URL)
USE_PGLITE=0

REDIS_URL=redis://redis:6379
# If Redis unavailable, collectors still run via manual API; BullMQ jobs are skipped
SKIP_REDIS=0

API_PORT=3001
WEB_ORIGIN=http://localhost:5173
REPORTS_DIR=/app/data/reports

# Optional: FRED official JSON API (CSV fallback needs no key)
FRED_API_KEY=

# Profile
BUDGET_CNY=7000
PLATFORM=Ryzen 9600X
WEEKLY_REPORT_TO=524541577@qq.com
AGENT_EMAIL_FROM=cuixu524541577-54mbqn@mail.grokbot.com

# JD SKU overrides (comma-separated sku=product_key)
# JD_SKUS=100066458123=cpu-9600x

# Once-daily collect (node-cron / BullMQ pattern). Box clock = user zone UTC-5.
DAILY_CRON=15 10 * * *
WEEKLY_CRON=0 9 * * 1

# Optional future: 什么值得买海纳开放平台
# SMZDM_API_KEY=
